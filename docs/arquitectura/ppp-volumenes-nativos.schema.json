{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPP · programa nativo multivolumen schema2",
  "description": "Fuente estructural: programa nativo de 21 columnas y 14 drivers. units_per_level es promedio numérico; units sigue derivado entero de Sheets. Bounds técnicos de transporte, no norma ni dataValidation observada. count<=rows e IDs únicos se verifican además del schema. No contiene un motor financiero.",
  "$ref": "#/$defs/canonical_collection",
  "$defs": {
    "canonical_collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "count",
        "volumes",
        "shared_allocation_mode"
      ],
      "properties": {
        "schema": {
          "const": 2
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "volumes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "values"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "values": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "footprint_m2",
                  "open_courtyard_m2",
                  "residential_levels",
                  "units_per_level",
                  "units",
                  "private_area_per_unit_m2",
                  "private_residential_area_m2",
                  "built_residential_area_m2",
                  "commercial_ground_m2",
                  "ground_services_m2",
                  "covered_ground_m2",
                  "gross_area_m2",
                  "basement_area_m2",
                  "direct_cost",
                  "construction_start_month",
                  "construction_duration_months",
                  "construction_end_month",
                  "sales_start_month",
                  "presale_months",
                  "delivery_months"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "footprint_m2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "open_courtyard_m2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "residential_levels": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 500
                  },
                  "units_per_level": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1000000,
                    "description": "Promedio de departamentos por nivel; no describe distribución tipológica. F lo redondea a total entero sólo en Sheets."
                  },
                  "units": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "private_area_per_unit_m2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "private_residential_area_m2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "built_residential_area_m2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "commercial_ground_m2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "ground_services_m2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "covered_ground_m2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "gross_area_m2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "basement_area_m2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "direct_cost": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "construction_start_month": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1200
                  },
                  "construction_duration_months": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 1200
                  },
                  "construction_end_month": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "sales_start_month": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1200
                  },
                  "presale_months": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 1200
                  },
                  "delivery_months": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 1200
                  }
                }
              }
            }
          }
        },
        "shared_allocation_mode": {
          "enum": [
            "preserve",
            "built_area"
          ]
        }
      }
    },
    "write_collection": {
