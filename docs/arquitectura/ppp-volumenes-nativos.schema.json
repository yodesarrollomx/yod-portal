      ],
      "properties": {
        "schema": {
          "const": 2
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "volumes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "values"
            ],
            "properties": {
              "id": {
