          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      }
    },
    "prewrite_rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "caso_id",
        "escenario_id",
        "base_revision",
        "actor",
        "payload_hash",
        "stage",
        "write_attempted",
        "error",
        "rejected_at"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "caso_id": {
          "type": "string",
          "minLength": 1
        },
        "escenario_id": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stage": {
          "const": "prewrite"
        },
        "write_attempted": {
          "const": false
        },
        "error": {
          "enum": [
            "revision_conflict",
            "active_driver_missing",
            "protected_native_driver",
            "native_formula_missing",
            "native_formula_manifest_changed",
            "native_geometry_conflict",
            "native_horizon_conflict",
            "shared_allocation_requires_reconciliation",
            "volume_identity_conflict"
          ]
        },
        "rejected_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "native_factory_preview": {
      "type": "object",
      "required": [
        "ok",
        "kind",
        "persisted",
        "template_revision",
        "inputs",
        "volumes",
        "capability"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "kind": {
          "const": "native_factory_preview"
        },
        "persisted": {
          "const": false
        },
        "template_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "inputs": {
          "type": "object",
          "description": "Supuestos de la plantilla nativa, sin sustituir los inputs capturados por el usuario."
        },
        "volumes": {
          "allOf": [
            {
              "$ref": "#/$defs/canonical_collection"
            },
            {
              "properties": {
                "count": {
                  "const": 1
                },
                "volumes": {
                  "maxItems": 1
                },
                "shared_allocation_mode": {
                  "const": "preserve"
                }
              }
            }
          ]
        },
        "capability": {
          "type": "object",
          "required": [
            "schema",
            "read",
            "write",
            "max_volumes",
            "fields",
            "allocation_modes",
            "shared_resources"
          ],
          "properties": {
            "schema": {
              "const": 2
            },
            "read": {
              "const": true
            },
            "write": {
              "const": true
            },
            "max_volumes": {
              "const": 16
            },
            "fields": {
              "type": "array",
              "minItems": 21,
              "maxItems": 21
            },
            "allocation_modes": {
              "$ref": "#/$defs/allocation_modes"
            },
            "shared_resources": {
              "$ref": "#/$defs/shared_resources"
            }
          }
        }
      }
    },
    "shared_resources": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,200}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "allocation_modes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "const": "preserve"
        },
        {
          "const": "built_area"
        }
      ],
      "items": false
    }
  },
