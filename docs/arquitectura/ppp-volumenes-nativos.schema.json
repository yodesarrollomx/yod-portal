                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "commercial_ground_m2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "ground_services_m2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "basement_area_m2": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "construction_start_month": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1200
                  },
                  "construction_duration_months": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 1200
                  },
                  "sales_start_month": {
