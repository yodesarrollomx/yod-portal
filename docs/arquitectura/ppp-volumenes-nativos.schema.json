        "tipo": {
          "const": "sheet-volumes"
        },
        "caso_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "tipo_desarrollo": {
          "const": "VERTICAL"
        },
        "escenario_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "revision_esperada": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "volumes": {
          "$ref": "#/$defs/write_collection"
        }
      }
    },
    "volume_receipt": {
      "type": "object",
      "required": [
        "request_id",
        "caso_id",
        "escenario_id",
        "base_revision",
        "result_revision",
        "volumes",
        "calculated"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "caso_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "escenario_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "base_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "result_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "volumes": {
          "$ref": "#/$defs/canonical_collection"
        },
        "calculated": {
          "type": "boolean"
        }
      }
    },
    "receipt_query": {
      "type": "object",
      "required": [
        "recurso",
        "caso_id",
        "escenario_id",
        "request_id"
      ],
      "properties": {
        "recurso": {
          "const": "sheet-volumes-receipt"
        },
        "caso_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "escenario_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
